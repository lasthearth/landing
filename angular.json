{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "last-hearth-landing": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "less"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/last-hearth-landing",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "server": "src/main.server.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "less",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "**/*",
                                "input": "node_modules/@taiga-ui/icons/src",
                                "output": "assets/taiga-ui/icons"
                            }
                        ],
                        "styles": [
                            "@taiga-ui/core/styles/taiga-ui-theme.less",
                            "src/styles.css",
                            "src/app/shared/styles/variables.less",
                            "src/app/shared/styles/appearances/icon.appearance.css"
                        ],
                        "scripts": [],
                        // Серверный режим: статика собирается заранее, статьи вики,
                        // новости, поселения и игроки рисуются по запросу.
                        // Что именно и как рендерить — решает src/app/app.routes.server.ts.
                        "outputMode": "server",
                        "ssr": {
                            "entry": "src/server.ts"
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1.4MB",
                                    "maximumError": "1.8MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "20kB",
                                    "maximumError": "24kB"
                                }
                            ],
                            "outputHashing": "all",
                            "fileReplacements": [
                                {
                                    "replace": "src/app/core/config/environments/environment.ts",
                                    "with": "src/app/core/config/environments/environment.prod.ts"
                                }
                            ]
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "host": "127.0.0.1",
                        "port": 4200,
                        "open": false
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "last-hearth-landing:build:production"
                        },
                        "development": {
                            "buildTarget": "last-hearth-landing:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "buildTarget": "last-hearth-landing:build:development",
                        "runner": "vitest",
                        "tsConfig": "tsconfig.spec.json",
                        "include": ["src/**/*.spec.ts"],
                        // Файлы про сжатие картинок требуют настоящего холста:
                        // createImageBitmap и 2D-контекст. Спек плашки вкладок
                        // меряет настоящие DOM-rect и пишет Jasmine withContext.
                        // Их выполняет test-browser.
                        "exclude": [
                            "src/app/shared/lib/compress-image.function.spec.ts",
                            "src/app/shared/lib/directives/tabs-pill.directive.spec.ts",
                            "src/app/shared/ui/image-file-input/image-file-input.component.spec.ts"
                        ],
                        "codeCoverage": false,
                        "codeCoverageReporters": ["text", "lcov", "json-summary"],
                        "watch": false
                    }
                },
                "test-browser": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        // Тот же прогонщик, что у `test`, но в настоящем Chrome:
                        // холст и живая геометрия DOM в jsdom не работают.
                        "buildTarget": "last-hearth-landing:build:development",
                        "runner": "vitest",
                        "tsConfig": "tsconfig.spec.browser.json",
                        "include": [
                            "src/app/shared/lib/compress-image.function.spec.ts",
                            "src/app/shared/lib/directives/tabs-pill.directive.spec.ts",
                            "src/app/shared/ui/image-file-input/image-file-input.component.spec.ts"
                        ],
                        "browsers": ["chromiumHeadless"],
                        "watch": false
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": "283abb33-de0d-446c-b0c6-611f275535d3"
    },
    "schematics": {
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    }
}

{
    "name": "last-hearth-landing",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "node -r dotenv/config node_modules/@angular/cli/bin/ng serve --host 127.0.0.1",
        "dev": "node -r dotenv/config node_modules/@angular/cli/bin/ng serve",
        "build": "node scripts/build.mjs",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --watch=false",
        "test:watch": "ng test --watch",
        "test:coverage": "ng test --watch=false --code-coverage",
        "test:browser": "ng run last-hearth-landing:test-browser",
        "test:ci": "npm run test && npm run test:browser",
        "lint": "node scripts/lint.mjs",
        "bootstrap": "npm ci",
        "history": "node scripts/history-tool.mjs",
        "verify": "node scripts/verify.mjs",
        "verify:full": "node scripts/verify.mjs --full",
        "arch": "node scripts/check-architecture.mjs",
        "map": "node scripts/gen-project-map.mjs",
        "sitemap": "node scripts/gen-sitemap.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "i18n": "node scripts/i18n-tool.mjs",
        "context:cost": "node scripts/check-context-budget.mjs",
        "format": "prettier --write AGENTS.md AGENT_RULES_MAP.md README.md docs package.json",
        "format:check": "prettier --check AGENTS.md AGENT_RULES_MAP.md README.md docs package.json",
        "lint:rules": "node --test tools/eslint-rules/"
    },
    "private": true,
    "dependencies": {

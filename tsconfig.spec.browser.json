/* Спецификации, которым нужен настоящий холст браузера: `createImageBitmap` и
   2D-контекст. jsdom их не даёт, поэтому эти два файла собраны под Jasmine и
   выполняются целью `test-browser` в ChromeHeadless. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/spec-browser",

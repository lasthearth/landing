# Контекст сборки: лишнее не отправляем в демон и не перетираем слои образа.

# Зависимости и артефакты собирает сам образ. Копировать их с хоста нельзя:
# на Windows это бинарники под другую платформу, сборка на них падает.
node_modules
dist
.angular
tmp
tmp-*
coverage
*.log

# Git и редакторы
.git
.gitignore
.vscode
.idea

# Документация и агентские артефакты сборке не нужны
docs
tasks
*.md
.codegraph
.openchamber
.playwright-mcp
.npm-cache

# Секреты: значения для сборки передаются аргументами/переменными окружения
.env
.env.*
